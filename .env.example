# Copy to .env before running docker compose. Never commit the filled file.

# Postgres + TimescaleDB
POSTGRES_USER=croniixx
POSTGRES_PASSWORD=croniixx_local
POSTGRES_DB=croniixx
DATABASE_URL=postgresql+asyncpg://croniixx:croniixx_local@postgres:5432/croniixx

# Redis
REDIS_URL=redis://redis:6379/0

# Terra API
# Values come from the Terra dashboard at dashboard.tryterra.co
TERRA_DEV_ID=
TERRA_API_KEY=
TERRA_SIGNING_SECRET=
TERRA_BASE_URL=https://api.tryterra.co/v2

# SMART on FHIR
# Registered client for the EHR launch sequence
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_REDIRECT_URI=http://localhost:3000/api/fhir/callback
FHIR_SCOPES=launch openid fhirUser profile patient/Patient.read patient/MedicationRequest.read offline_access

# JWT for mobile auth
JWT_SECRET=change_me_in_every_environment
JWT_ISSUER=croniixx
JWT_AUDIENCE=croniixx-mobile
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# Expo push
EXPO_ACCESS_TOKEN=

# Service URLs used for server to server calls inside the compose network
SYNC_SERVICE_URL=http://sync:8001
ENGINE_SERVICE_URL=http://engine:8002
REMINDER_SERVICE_URL=http://reminder-api:8003

# Browser reachable URLs for the Next.js app
NEXT_PUBLIC_SYNC_URL=http://localhost:8001
NEXT_PUBLIC_ENGINE_URL=http://localhost:8002
NEXT_PUBLIC_REMINDER_URL=http://localhost:8003
